# Tài khoản Facebook dùng để test (nên dùng tài khoản test riêng, KHÔNG dùng tài khoản cá nhân)
# Để trống nếu muốn tự gõ tay trên cửa sổ trình duyệt
FB_EMAIL=
FB_PASSWORD=

# "msedge" = Microsoft Edge, "chrome" = Google Chrome (cả hai đều ít bị Facebook nghi ngờ hơn Chromium của Playwright)
# Để trống = dùng Chromium bundled của Playwright
BROWSER_CHANNEL=

# Facebook hay chặn/checkpoint trình duyệt headless -> mặc định chạy có giao diện
HEADLESS=false

# App ID của game mà account này được cấp quyền chơi (mỗi account test chỉ chơi được 1 game)
FB_GAME_ID=
# Tên game (tuỳ chọn) — dùng cho entry point qua ô tìm kiếm
FB_GAME_NAME=

# Bước "vào game thành công": chờ game tới scene này, bấm 1 nút rồi kiểm tra kết quả (chỉ hỗ trợ game Cocos Creator)
# Chạy `npm run game:buttons` để xem tên scene + đường dẫn các nút của game
FB_GAME_READY_SCENE=
# Nút sẽ bấm — dùng Settings để không ảnh hưởng tiến trình chơi
FB_GAME_CHECK_BUTTON=
# Node phải hiện ra sau khi bấm (popup Settings). Để trống = chờ scene đổi (vd khi bấm Play)
FB_GAME_CHECK_EXPECT_NODE=
