# Tài khoản test của từng game (mỗi account chỉ được cấp quyền chơi 1 game)
# Tên biến: FB_EMAIL_<SLUG> / FB_PASSWORD_<SLUG>, với SLUG = tên thư mục trong games/ viết hoa, "-" thành "_"
# Để trống mật khẩu nếu muốn tự gõ tay trên cửa sổ trình duyệt khi `npm run login -- <slug>`
FB_EMAIL_SNAKE_ESCAPE=
FB_PASSWORD_SNAKE_ESCAPE=

# "msedge" = Microsoft Edge, "chrome" = Google Chrome (cả hai đều ít bị Facebook nghi ngờ hơn Chromium của Playwright)
# Để trống = dùng Chromium bundled của Playwright
BROWSER_CHANNEL=

# true = chạy ẩn, không mở cửa sổ trình duyệt (UA "HeadlessChrome" được thay bằng UA thật để Facebook không chặn)
# false = hiện cửa sổ, dùng khi cần xem trực tiếp để debug. `npm run login` luôn hiện cửa sổ (có thể phải nhập 2FA)
HEADLESS=true

# Cấu hình game (id, scene, nút, thiết bị) nằm trong games/<slug>/config.ts
